{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react",
    "jsxFactory": "ForgeUI.createElement",
    "jsxFragmentFactory": "ForgeUI.Fragment",
    "sourceMap": true,
    "outDir": "dist",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "site/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
