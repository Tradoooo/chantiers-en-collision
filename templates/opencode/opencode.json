{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "./.opencode/chantiers",
      "options": {
        "url": "{env:CHANTIER_URL}",
        "token": "{env:CHANTIER_TOKEN}",
        "repo": "{env:CHANTIER_REPO}",
        "session": "{env:CHANTIER_SESSION}"
      }
    }
  ],
  "mcp": {
    "servers": {
      "chantiers-forge": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/forge/2ef208cc-6621-42a7-8557-5ce5ab3f6882",
        "enabled": true
      }
    }
  }
}
