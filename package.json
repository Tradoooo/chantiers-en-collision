{
  "name": "chantiers-en-collision",
  "version": "0.1.0",
  "description": "Worksite collision detection for Jira: every work in progress has a footprint on the repo, overlaps are flagged before the first line is written. Forge app - Codegeist 2026.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:manifest": "node scripts/check-manifest.mjs",
    "verify": "npm run lint && npm run typecheck && npm run check:manifest && npm run test",
    "build": "tsc -p tsconfig.json --outDir dist"
  },
  "dependencies": {
    "@forge/api": "^8.5.0",
    "@forge/resolver": "^2.0.2",
    "@forge/sql": "^4.0.10",
    "@forge/ui": "^1.11.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "js-yaml": "^5.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
